{
  "name": "toe-to-toe",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/bungee": "5.3.0",
    "@fontsource/permanent-marker": "5.3.0",
    "@fontsource/special-elite": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "pixi.js": "8.23.0",
    "trystero": "0.27.0",
    "web-audio-beat-detector": "8.2.39"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
