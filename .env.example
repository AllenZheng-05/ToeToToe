# Both values are optional. The game runs fully without them (presets,
# browser-saved drawings and songs, matches). They only add saving across devices.
#
# Copy this file to .env.local for development. For production, set the same
# two names as build environment variables in the host (Cloudflare Pages).
#
# The anon (publishable) key is public by design. It is safe in a static site
# because row-level security limits what it can reach.
# NEVER put the service role (secret) key here or anywhere in this repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
